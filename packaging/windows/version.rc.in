// Windows resources of the shipped executables, configured per executable by
// cmake/Packaging.cmake: the version resource (Explorer > Properties > Details) and,
// for the application only, its icon.
#include <winver.h>

@PMM_RC_ICON@

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PMM_RC_VERSION_NUMBERS@
PRODUCTVERSION @PMM_RC_VERSION_NUMBERS@
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "@PMM_RC_VENDOR@"
            VALUE "FileDescription", "@PMM_RC_DESCRIPTION@"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "@PMM_RC_NAME@"
            VALUE "LegalCopyright", "Copyright (c) 2026 @PMM_RC_VENDOR@. MIT License."
            VALUE "OriginalFilename", "@PMM_RC_NAME@.exe"
            VALUE "ProductName", "Paradox Mod Manager"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
