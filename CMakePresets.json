{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_PREFIX_PATH": "$env{QT_ROOT_DIR}"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (application + tests)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release (application + tests)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "core-debug",
      "displayName": "Core libraries and tests without Qt",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PMM_BUILD_APP": "OFF"
      }
    },
    {
      "name": "core-sanitize",
      "displayName": "Core without Qt, MSVC with AddressSanitizer",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PMM_BUILD_APP": "OFF",
        "PMM_ENABLE_SANITIZERS": "ON",
        "PMM_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "core-clang-cl",
      "displayName": "Core without Qt, clang-cl with UBSan, warnings as errors",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "PMM_BUILD_APP": "OFF",
        "PMM_ENABLE_UBSAN": "ON",
        "PMM_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "ci",
      "displayName": "CI (application + tests, warnings as errors)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "PMM_WARNINGS_AS_ERRORS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "core-debug",
      "configurePreset": "core-debug"
    },
    {
      "name": "core-sanitize",
      "configurePreset": "core-sanitize"
    },
    {
      "name": "core-clang-cl",
      "configurePreset": "core-clang-cl"
    },
    {
      "name": "ci",
      "configurePreset": "ci"
    }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "inherits": "base",
      "configurePreset": "release"
    },
    {
      "name": "core-debug",
      "inherits": "base",
      "configurePreset": "core-debug"
    },
    {
      "name": "core-sanitize",
      "inherits": "base",
      "configurePreset": "core-sanitize",
      "environment": {
        "PATH": "$env{VCToolsInstallDir}bin/Hostx64/x64;$penv{PATH}"
      }
    },
    {
      "name": "core-clang-cl",
      "inherits": "base",
      "configurePreset": "core-clang-cl"
    },
    {
      "name": "ci",
      "inherits": "base",
      "configurePreset": "ci"
    }
  ]
}
